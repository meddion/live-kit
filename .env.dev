APP_LOG_DEBUG=true
APP_PUBLIC_LIVEKIT_SERVER_URL=ws://localhost:7880
APP_PRIVATE_LIVEKIT_SERVER_URL=ws://livekit-server:7880
APP_MEET_URL=http://localhost:3000
APP_DB_FILE=/app/data/main.db

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Server-side key map consumed by livekit-server (format: "key: secret").
LIVEKIT_KEYS=devkey: secret


